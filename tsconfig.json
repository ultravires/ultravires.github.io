{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "paths": {
      "@theme/*": [
        "./docs/.vitepress/theme/*"
      ]
    },
    "types": [
      "vitepress",
      "@types/node"
    ],
    "outDir": "./docs/.vitepress/"
  },
  "include": [
    "./docs/.vitepress/**/*",
    "./docs/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}